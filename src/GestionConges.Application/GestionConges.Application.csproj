<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>GestionConges.Application</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<!-- Entity Framework Core - Version compatible .NET 8 -->
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.10" />

		<!-- Microsoft Extensions - Version compatible .NET 8 -->
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />

		<!-- JWT - Version compatible .NET 8 -->
		<PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.1.2" />
		<PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.1.2" />

		<!-- Pour les validations (DataAnnotations) -->
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\GestionConges.Domain\GestionConges.Domain.csproj" />
	</ItemGroup>

</Project>