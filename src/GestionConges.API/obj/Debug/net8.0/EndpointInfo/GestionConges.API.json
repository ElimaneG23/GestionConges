  "components": {
    "schemas": {
      "CreateEmployeeDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "nullable": true
          },
          "lastName": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "type": "string",
            "nullable": true
          },
          "managerId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "jobTitle": {
            "type": "string",
            "nullable": true
          },
          "hireDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateHolidayDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "isRecurringYearly": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "CreateLeaveRequestDto": {
        "type": "object",
        "properties": {
          "leaveTypeId": {
            "type": "string",
            "format": "uuid"
          },
          "startDate": {
            "type": "string",
            "format": "date-time"
          },
          "endDate": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateLeaveTypeDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "defaultDaysPerYear": {
            "type": "integer",
            "format": "int32"
          },
          "requiresJustification": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "CreateTenantDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "subdomain": {
            "type": "string",
            "nullable": true
          },
          "adminFirstName": {
            "type": "string",
            "nullable": true
          },
          "adminLastName": {
            "type": "string",
            "nullable": true
          },
          "adminEmail": {
            "type": "string",
            "nullable": true
          },
          "adminPassword": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LoginRequestDto": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 6,
            "type": "string"
          },
          "subdomain": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ProcessLeaveRequestDto": {
        "type": "object",
        "properties": {
          "approve": {
            "type": "boolean"
          },
          "managerComment": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "RegisterTenantRequestDto": {
        "required": [
          "adminEmail",
          "adminFirstName",
          "adminLastName",
          "adminPassword",
          "companyName",
          "subdomain"
        ],
        "type": "object",
        "properties": {
          "companyName": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "subdomain": {
            "maxLength": 50,
            "minLength": 1,
            "pattern": "^[a-z0-9]+$",
            "type": "string"
          },
          "adminEmail": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "adminPassword": {
            "minLength": 8,
            "type": "string"
          },
          "adminFirstName": {
            "minLength": 1,
            "type": "string"
          },
          "adminLastName": {
            "minLength": 1,
            "type": "string"
          },
          "adminPhone": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UpdateEmployeeDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "nullable": true
          },
          "lastName": {
            "type": "string",
            "nullable": true
          },
          "jobTitle": {
            "type": "string",
            "nullable": true
          },
          "managerId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "isActive": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "UpdateLeaveTypeDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "defaultDaysPerYear": {
            "type": "integer",
            "format": "int32"
          },
          "requiresJustification": {
            "type": "boolean"
          },
          "isActive": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "UpdateTenantBrandingDto": {
        "type": "object",
        "properties": {
          "logoUrl": {
            "type": "string",
            "nullable": true
          },
          "primaryColor": {
            "type": "string",
            "nullable": true
          },
          "secondaryColor": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UpdateTenantSettingsDto": {
        "type": "object",
        "properties": {
          "workingDaysPerWeek": {
            "type": "integer",
            "format": "int32"
          },
          "carryOverAllowed": {
            "type": "boolean"
          },
          "maxCarryOverDays": {
            "type": "integer",
            "format": "int32"
          },
          "annualLeaveDefaultDays": {
            "type": "integer",
            "format": "int32"
          },
          "requireManagerApproval": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  }
}